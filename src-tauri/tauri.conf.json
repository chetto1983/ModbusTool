{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModbusTool",
  "version": "3.0.0",
  "identifier": "io.github.chetto1983.modbustool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModbusTool",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 640
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
