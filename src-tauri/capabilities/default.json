{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events, file dialogs, reading and writing user-chosen files and the recordings folder, updates and restart",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/ModbusTool/recordings"
        },
        {
          "path": "$DOCUMENT/ModbusTool/recordings/*"
        },
        {
          "path": "$HOME/ModbusTool/recordings"
        },
        {
          "path": "$HOME/ModbusTool/recordings/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
