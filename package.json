    "mutation": "stryker run",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "jscpd": "^4.3.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "^9.33.1"
  },
  "dependencies": {
