{
  "name": "modbus-tool",
  "private": true,
  "version": "3.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "tauri": "tauri",
    "lint": "oxlint --max-warnings=0 .",
    "format": "prettier --write .",
